<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.imagunity</groupId>
    <artifactId>imagunity-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ImagUnity</name>
    <description>Box de transport d'examens DICOM via des relais aveugles</description>

    <modules>
        <module>domain</module>
        <module>dicom</module>
        <module>packaging</module>
        <module>transport</module>
        <module>persistence</module>
        <module>api</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <dcm4che.version>5.35.2</dcm4che.version>
        <zstd-jni.version>1.5.7-26</zstd-jni.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-dicom</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-packaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-transport</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dcm4che</groupId>
                <artifactId>dcm4che-net</artifactId>
                <version>${dcm4che.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.luben</groupId>
                <artifactId>zstd-jni</artifactId>
                <version>${zstd-jni.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <!-- dcm4che n'est pas publié sur Maven Central -->
        <repository>
            <id>dcm4che</id>
            <url>https://www.dcm4che.org/maven2/</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
</project>
