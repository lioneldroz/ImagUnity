<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.imagunity</groupId>
    <artifactId>imagunity-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ImagUnity</name>
    <description>Box de transport d'examens DICOM via des relais aveugles</description>

    <modules>
        <module>domain</module>
        <module>directory</module>
        <module>directory-server</module>
        <module>dicom</module>
        <module>packaging</module>
        <module>transport</module>
        <module>persistence</module>
        <module>orchestration</module>
        <module>api</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <dcm4che.version>5.35.2</dcm4che.version>
        <zstd-jni.version>1.5.7-26</zstd-jni.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <jacoco.version>0.8.16</jacoco.version>
        <!-- Minimum coverage thresholds checked by "mvn verify" (see jacoco-maven-plugin),
             applied to each module (BUNDLE). Measured on 2026-11-11: 98.5 % of lines,
             96.3 % of branches (lowest module: dicom, 97.4 % / 93.9 %). Can be overridden on the
             command line, e.g. -Dcouverture.lignes.min=0.90 -->
        <couverture.lignes.min>0.95</couverture.lignes.min>
        <couverture.branches.min>0.75</couverture.branches.min>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-directory</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-dicom</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-packaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-transport</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.imagunity</groupId>
                <artifactId>imagunity-orchestration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dcm4che</groupId>
                <artifactId>dcm4che-net</artifactId>
                <version>${dcm4che.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.luben</groupId>
                <artifactId>zstd-jni</artifactId>
                <version>${zstd-jni.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Couverture des tests : mesurée à chaque "mvn verify", seuils bloquants par module -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${couverture.lignes.min}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${couverture.branches.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <!-- dcm4che n'est pas publié sur Maven Central -->
        <repository>
            <id>dcm4che</id>
            <url>https://www.dcm4che.org/maven2/</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
</project>
