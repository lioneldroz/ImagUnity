<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.imagunity</groupId>
        <artifactId>imagunity-parent</artifactId>
        <version>0.15.0-SNAPSHOT</version>
    </parent>

    <artifactId>imagunity-app</artifactId>
    <name>ImagUnity — app</name>
    <description>Assemblage Spring Boot de la box</description>

    <dependencies>
        <dependency>
            <groupId>com.imagunity</groupId>
            <artifactId>imagunity-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.imagunity</groupId>
            <artifactId>imagunity-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>com.imagunity</groupId>
            <artifactId>imagunity-directory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.imagunity</groupId>
            <artifactId>imagunity-transport</artifactId>
        </dependency>
        <dependency>
            <groupId>com.imagunity</groupId>
            <artifactId>imagunity-packaging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.imagunity</groupId>
            <artifactId>imagunity-dicom</artifactId>
        </dependency>
        <dependency>
            <groupId>com.imagunity</groupId>
            <artifactId>imagunity-configuration</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <!-- Console React (frontend/) construite et embarquée dans le jar de la box, servie sur « / ».
             Demande Node.js 24 et npm ; -Dconsole.skip=true construit la box sans console (API seule). -->
        <console.skip>false</console.skip>
        <console.dir>${project.basedir}/../../frontend</console.dir>
    </properties>

    <build>
        <finalName>imagunity-box</finalName>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <skip>${console.skip}</skip>
                    <executable>npm</executable>
                    <workingDirectory>${console.dir}</workingDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>console-npm-ci</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <arguments><argument>ci</argument><argument>--no-audit</argument><argument>--no-fund</argument></arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>console-npm-build</id>
                        <phase>generate-resources</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <arguments><argument>run</argument><argument>build</argument></arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>console-copie</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <skip>${console.skip}</skip>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${console.dir}/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
