bin/
obj/
build/
dist/
out/
target/
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# --- Logs et fichiers temporaires ---
*.log
logs/
*.tmp
*.swp

# --- Fichiers verrous Office ---
~$*

