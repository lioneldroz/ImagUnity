# Configuration du site central (copier en .env, à côté de compose.yml ; droits 0600). Voir le guide.

# Noms d'hôte publics (enregistrements DNS vers cette machine).
RELAIS_HOTE=relais.exemple.org
ANNUAIRE_HOTE=annuaire.exemple.org
# Adresses (CIDR, séparées par des espaces) autorisées pour l'administration et le dépôt des entrées.
RESEAU_ADMIN=192.168.1.0/24
# Certificats : vide = Let's Encrypt (ports 80 et 443 joignables depuis Internet) ;
# local_certs = autorité interne de Caddy (réseau privé), à faire approuver par les box.
TLS_INTERNE=

# Empreinte de la clé du responsable de l'organisation, vérifiée hors bande.
EMPREINTE_RESPONSABLE=XXXX-XXXX-XXXX-XXXX-XXXX-XXXX
# Empreinte de la clé de l'éditeur (config/editeur.pub.json), vérifiée hors bande : publier-version.sh refuse une
# version signée par une autre clé.
EMPREINTE_EDITEUR=XXXX-XXXX-XXXX-XXXX-XXXX-XXXX
# Version des images du site central, chargées depuis une livraison (docker load) ; vide : images construites ici.
IMAGUNITY_VERSION=

# Mots de passe : à générer (openssl rand -base64 24), jamais ceux de cet exemple.
RELAIS_DB_MOT_DE_PASSE=a-remplacer
ANNUAIRE_DB_MOT_DE_PASSE=a-remplacer
ANNUAIRE_COMPTE=responsable
ANNUAIRE_MOT_DE_PASSE=a-remplacer

# Quota de morceaux en attente par box sur le relais.
RELAIS_QUOTA_PAR_BOX=100GB
