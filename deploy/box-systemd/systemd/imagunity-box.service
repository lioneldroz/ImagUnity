[Unit]
Description=ImagUnity : box de transfert d'examens DICOM
Documentation=https://github.com/lioneldroz/ImagUnity/blob/main/docs/installation-box-rocky10.md
Wants=network-online.target
After=network-online.target time-sync.target
# Vérification des versions signées, sous le compte imagunity-maj, à chaque démarrage de la box.
Requires=imagunity-box-choix.service
After=imagunity-box-choix.service
OnFailure=imagunity-alerte@%n.service

[Service]
Type=exec
User=imagunity
Group=imagunity
# Messages accentués lisibles dans le journal, quelle que soit la langue du système.
Environment=LANG=C.UTF-8
EnvironmentFile=/etc/imagunity/box.env
LoadCredential=phrase-box:/etc/imagunity/phrase-box
StateDirectory=imagunity-box
StateDirectoryMode=0700
# Aucun processus root : le choix de la version est fait par imagunity-box-choix.service (compte imagunity-maj),
# la box tourne sous le compte imagunity et ne peut modifier ni le lanceur, ni les versions, ni l'état anti-retour.
ExecStart=/opt/imagunity/bin/demarrer.sh
Restart=on-failure
RestartSec=15s
TimeoutStartSec=180s
TimeoutStopSec=60s
SuccessExitStatus=143
UMask=0077
LimitNOFILE=65536

# Durcissement : système de fichiers en lecture seule sauf /var/lib/imagunity-box, aucun privilège.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
