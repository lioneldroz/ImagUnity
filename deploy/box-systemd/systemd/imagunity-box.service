[Unit]
Description=ImagUnity : box de transfert d'examens DICOM
Documentation=https://github.com/lioneldroz/ImagUnity/blob/main/docs/installation-box-rocky10.md
Wants=network-online.target
After=network-online.target time-sync.target
OnFailure=imagunity-alerte@%n.service

[Service]
Type=exec
User=imagunity
Group=imagunity
EnvironmentFile=/etc/imagunity/box.env
LoadCredential=phrase-box:/etc/imagunity/phrase-box
StateDirectory=imagunity-box
StateDirectoryMode=0700
RuntimeDirectory=imagunity-box
# Lanceur en root (+) : vérifie les versions signées. Le logiciel, lui, tourne sous le compte imagunity.
ExecStartPre=+/opt/imagunity/bin/choisir.sh
ExecStart=/opt/imagunity/bin/demarrer.sh
Restart=on-failure
RestartSec=15s
TimeoutStartSec=180s
TimeoutStopSec=60s
SuccessExitStatus=143
UMask=0077
LimitNOFILE=65536

# Durcissement : système de fichiers en lecture seule sauf /var/lib/imagunity-box, aucun privilège.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
