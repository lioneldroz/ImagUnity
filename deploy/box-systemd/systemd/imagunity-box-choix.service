[Unit]
Description=ImagUnity : vérification des versions signées avant le démarrage de la box
Documentation=https://github.com/lioneldroz/ImagUnity/blob/main/docs/installation-box-rocky10.md
Wants=network-online.target
After=network-online.target time-sync.target
# Lancée par imagunity-box.service (Requires=) à chacun de ses démarrages.

[Service]
Type=oneshot
User=imagunity-maj
Group=imagunity-maj
EnvironmentFile=/etc/imagunity/box.env
StateDirectory=imagunity-maj
StateDirectoryMode=0755
# Le choix reste lisible par la box (compte imagunity) après la fin de cette unité.
RuntimeDirectory=imagunity-choix
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/opt/imagunity/bin/choisir.sh
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
