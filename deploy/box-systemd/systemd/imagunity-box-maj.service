[Unit]
Description=ImagUnity : mise à jour automatique de la box (versions signées)
Documentation=https://github.com/lioneldroz/ImagUnity/blob/main/docs/installation-box-rocky10.md
Wants=network-online.target
After=network-online.target
OnFailure=imagunity-alerte@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/imagunity/box.env
ExecStart=/opt/imagunity/bin/mise-a-jour.sh
TimeoutStartSec=2h
