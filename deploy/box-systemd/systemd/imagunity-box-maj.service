[Unit]
Description=ImagUnity : mise à jour automatique de la box (versions signées)
Documentation=https://github.com/lioneldroz/ImagUnity/blob/main/docs/installation-box-rocky10.md
Wants=network-online.target
After=network-online.target
OnFailure=imagunity-alerte@%n.service

[Service]
Type=oneshot
User=imagunity-maj
Group=imagunity-maj
EnvironmentFile=/etc/imagunity/box.env
StateDirectory=imagunity-maj
StateDirectoryMode=0755
ExecStart=/opt/imagunity/bin/mise-a-jour.sh
TimeoutStartSec=2h
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# AF_UNIX : redémarrage de la box par systemctl (D-Bus, autorisé par polkit pour ce seul service).
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
