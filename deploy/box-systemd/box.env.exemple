# Configuration de la box ImagUnity (/etc/imagunity/box.env, root, 0600 : lue par systemd seul, qui la transmet aux
# services de la box).
# Une variable par ligne, NOM=valeur, sans guillemets. Voir docs/guides/installation-box-rocky10.md.

# --- Identité et réseau du site ----------------------------------------------------------------------------------
IMAGUNITY_BOX_NAME=box-site-a
# Adresse IP de la box sur le réseau du site : la console et l'entrée DICOM n'écoutent que sur elle.
SERVER_ADDRESS=192.168.1.78
IMAGUNITY_DICOM_BIND_ADDRESS=192.168.1.78
IMAGUNITY_HTTP_PORT=8080
IMAGUNITY_DICOM_PORT=11112
IMAGUNITY_DATA_DIR=/var/lib/imagunity-box

# --- Console et API (compte opérateur) ---------------------------------------------------------------------------
IMAGUNITY_CONSOLE_USER=operateur
# Mot de passe haché (recommandé) : voir le guide, § « Mot de passe de l'opérateur ».
IMAGUNITY_CONSOLE_PASSWORD={bcrypt}$2a$10$remplacer.par.le.hachage.du.mot.de.passe.......................

# --- Entrée DICOM : qui peut envoyer, et vers quels partenaires ----------------------------------------------------
IMAGUNITY_DICOM_ALLOWED_CALLING_AETS=PACS_SITE_A
# Adresses (ou réseaux CIDR) admises à ouvrir une association DICOM ; vide : toutes.
IMAGUNITY_DICOM_LIMITS_ALLOWED_SOURCES=192.168.1.10
# Destination DICOM à déclarer dans le PACS → partenaire (nom de l'appairage).
IMAGUNITY_DICOM_ROUTES_0_CALLED_AET=IU_TO_B
IMAGUNITY_DICOM_ROUTES_0_DESTINATION=box-b

# --- Restitution des examens reçus au PACS du site ----------------------------------------------------------------
IMAGUNITY_PACS_HOST=192.168.1.10
IMAGUNITY_PACS_PORT=104
IMAGUNITY_PACS_AET=PACS_SITE_A
IMAGUNITY_BOX_AET=IMAGUNITY_A

# --- Site central : annuaire et relais (HTTPS) ---------------------------------------------------------------------
IMAGUNITY_DIRECTORY_ENABLED=true
IMAGUNITY_DIRECTORY_URL=https://annuaire.exemple.org
IMAGUNITY_DIRECTORY_ORGANIZATION_KEY=/etc/imagunity/organisation.pub.json
# Empreinte de la clé du responsable, vérifiée hors bande (de vive voix avec lui).
IMAGUNITY_DIRECTORY_ORGANIZATION_CODE=XXXX-XXXX-XXXX-XXXX-XXXX-XXXX
IMAGUNITY_IU_RELAY=https://relais.exemple.org

# --- Clés de la box protégées par le TPM (facultatif, recommandé) -------------------------------------------------
IMAGUNITY_DIRECTORY_IDENTITY_TPM=false
IMAGUNITY_DIRECTORY_IDENTITY_TPM_PCRS=sha256:0,4,7,8,9

# --- Mises à jour signées et automatiques --------------------------------------------------------------------------
IMAGUNITY_RELEASE_KEY=/etc/imagunity/editeur.pub.json
# Empreinte de la clé de l'éditeur, vérifiée hors bande.
IMAGUNITY_RELEASE_CODE=XXXX-XXXX-XXXX-XXXX-XXXX-XXXX
IMAGUNITY_RELEASE_DIR=/var/lib/imagunity-maj
IMAGUNITY_RELEASE_BUNDLED=/opt/imagunity/imagunity-box.jar
# Canal de mises à jour : « pilote » pour les premières box, « general » pour les autres.
IMAGUNITY_UPDATE_URL=https://annuaire.exemple.org/mises-a-jour/general/

# --- Java ---------------------------------------------------------------------------------------------------------
# Certificat d'une autorité interne (site central sans certificat public) : voir le guide.
#IMAGUNITY_JAVA_OPTS=-Djavax.net.ssl.trustStore=/etc/imagunity/confiance.p12 -Djavax.net.ssl.trustStorePassword=changeit
